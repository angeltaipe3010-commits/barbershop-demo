# ============================================================================
#  Copia este archivo a ".env" y rellena con tus credenciales.
#  Solo las variables con prefijo VITE_ llegan al navegador: NUNCA pongas aquí
#  la service_role key de Supabase.
# ============================================================================

# --- Modo de la aplicación --------------------------------------------------
#   true  → DEMO. Base SQLite (WebAssembly) dentro del navegador: sin servidor,
#           sin cuentas y sin coste. Es lo que se publica en un portafolio.
#           Se entra con  admin / demo1234  (o juan, marco, kevin).
#   false → Supabase real. Requiere las credenciales de abajo y haber ejecutado
#           el SQL de supabase/setup/.
#
# Si no pones nada y tampoco hay credenciales, arranca en demo. Así un
# despliegue nuevo funciona sin configurar una sola variable.
VITE_DEMO=true

# --- Supabase (Project Settings → API) -------------------------------------
# Solo se usan cuando VITE_DEMO=false.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# --- Acceso ----------------------------------------------------------------
# Dominio interno con el que se arma el email a partir del nombre de usuario.
# Los barberos solo escriben su "usuario"; nunca ven este correo.
#
# DEBE COINCIDIR con el dominio de los correos en auth.users. Si aquí pones
# "demo.com" y el usuario está creado como juan@otra.com, escribir "juan" en el
# login no lo encontrará (aunque sí funcionaría escribiendo el correo completo).
# `seed_demo.sql` crea sus usuarios en @demo.com.
VITE_AUTH_EMAIL_DOMAIN=demo.com

# --- Localización (opcional) -----------------------------------------------
# Por defecto: Perú (Soles, es-PE).
# VITE_LOCALE=es-PE
# VITE_CURRENCY=PEN
